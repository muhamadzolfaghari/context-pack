{
  "name": "@muhamadzolfaghari/context-pack",
  "version": "1.2.0",
  "description": "Smart, deterministic, token-budgeted repository context packer for AI-assisted development workflows.",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./bin/context-core.mjs": "./bin/context-core.mjs"
  },
  "bin": {
    "context-pack": "./bin/cxd-cli.mjs",
    "cxd": "./bin/cxd-cli.mjs"
  },
  "files": [
    "src/",
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "context",
    "context-window",
    "llm",
    "ai",
    "cli",
    "developer-tools",
    "token-budget",
    "code-context",
    "repository"
  ],
  "author": {
    "name": "Mohammad Zolfaghari",
    "url": "https://github.com/muhamadzolfaghari"
  },
  "license": "ISC",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "check": "node --check src/index.js && node --check bin/context-core.mjs && node --check bin/cxd-cli.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "prepublishOnly": "npm run check && npm test && npm run verify:package"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muhamadzolfaghari/context-pack.git"
  },
  "bugs": {
    "url": "https://github.com/muhamadzolfaghari/context-pack/issues"
  },
  "homepage": "https://github.com/muhamadzolfaghari/context-pack#readme"
}
